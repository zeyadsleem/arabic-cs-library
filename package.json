{
  "name": "arabic-cs-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "المكتبة العربية لعلوم الحاسوب",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-go-tour.mjs && node scripts/build-content.mjs && vite build",
    "preview": "vite preview",
    "content": "node scripts/build-go-tour.mjs && node scripts/build-content.mjs",
    "build:go-browser": "node scripts/build-go-browser.mjs",
    "test:tour": "node --test tests/tour/*.test.js && playwright test",
    "test:mobile": "playwright test mobile.spec.js",
    "deploy": "node scripts/deploy-gh-pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.20.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.9",
    "markdown-it": "^14.1.0",
    "node-html-parser": "^7.0.1"
  },
  "packageManager": "pnpm@11.21.0"
}
